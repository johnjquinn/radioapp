{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://example.com/example.json",
    "type": "object",
    "properties": {
        "title": {
            "type": "string"
        },
        "length": {
            "type": "number"
        },
        "artist": {
            "type": "array",
            "items": "string"
        },
        "discNum": {
            "type": "number",
            "minimum": 1
        },
        "trackNum": {
            "type": "number",
            "minimum": 1
        },
        "explicit": {
            "type": "boolean"
        }
    },
    "additionalProperties": false,
    "required": [
        "title",
        "length",
        "artist",
        "discNum",
        "trackNum",
        "explicit"
    ]
}